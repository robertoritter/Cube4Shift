# Cube4Code .gitattributes base
# Texto normalizado para LF no repositório
* text=auto eol=lf

# Scripts do Windows mantêm CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binários: sem conversão de fim de linha nem diff de texto
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.pptx binary
